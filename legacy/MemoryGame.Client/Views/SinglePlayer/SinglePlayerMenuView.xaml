<UserControl x:Class="MemoryGame.Client.Views.SinglePlayer.SinglePlayerMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MemoryGame.Client.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720">

    <UserControl.Resources>
        <!-- Difficulty button: highlighted when selected -->
        <Style x:Key="DifficultyButton" TargetType="Button" BasedOn="{StaticResource PastelButton}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="DifficultyButtonSelected" TargetType="Button" BasedOn="{StaticResource DifficultyButton}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GlobalBackgroundSource}"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="680">

            <!-- Title -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_Singleplayer]}"
                       Style="{DynamicResource PastelHeading}"
                       HorizontalAlignment="Center"/>

            <!-- Difficulty cards -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.14" Color="#3D1C1C"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: difficulty selector -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_SelectDifficulty]}"
                                   Style="{DynamicResource PastelTextBlock}"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   Margin="0,0,0,14"/>

                        <!-- Easy -->
                        <Button Command="{Binding SelectEasyCommand}"
                                Height="56" Margin="0,0,0,10"
                                HorizontalContentAlignment="Left" Padding="16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PastelButton}">
                                    <Setter Property="Height" Value="56"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEasy}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢  " FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Easy]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Easy_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Medium -->
                        <Button Command="{Binding SelectMediumCommand}"
                                Height="56" Margin="0,0,0,10"
                                HorizontalContentAlignment="Left" Padding="16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PastelButton}">
                                    <Setter Property="Height" Value="56"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMedium}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟡  " FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Medium]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Medium_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Hard -->
                        <Button Command="{Binding SelectHardCommand}"
                                Height="56" Margin="0,0,0,10"
                                HorizontalContentAlignment="Left" Padding="16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PastelButton}">
                                    <Setter Property="Height" Value="56"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHard}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔴  " FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Hard]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Hard_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Custom -->
                        <Button Command="{Binding SelectCustomCommand}"
                                Height="56" Margin="0,0,0,0"
                                HorizontalContentAlignment="Left" Padding="16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PastelButton}">
                                    <Setter Property="Height" Value="56"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomMode}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️  " FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Custom]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Custom_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: custom settings (only visible in Custom mode) -->
                    <StackPanel Grid.Column="2"
                                Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_CustomSettings]}"
                                   Style="{DynamicResource PastelTextBlock}"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   Margin="0,0,0,14"/>

                        <!-- Card count -->
                        <TextBlock Style="{DynamicResource PastelTextBlock}"
                                   FontSize="13" Margin="0,0,0,6">
                            <Run Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_CardCount], Mode=OneWay}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding CustomCardCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding CustomCardCountOptions}"
                                  SelectedItem="{Binding CustomCardCount}"
                                  Style="{DynamicResource PastelComboBox}"
                                  Margin="0,0,0,18"/>

                        <!-- No time limit toggle -->
                        <CheckBox IsChecked="{Binding CustomNoTimeLimit}"
                                  Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_NoTimeLimit]}"
                                  Foreground="{DynamicResource PastelText}"
                                  FontFamily="{DynamicResource DefaultFont}"
                                  Margin="0,0,0,12"/>

                        <!-- Turn time (hidden when no time limit) -->
                        <StackPanel Visibility="{Binding ShowCustomTurnTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{DynamicResource PastelTextBlock}"
                                       FontSize="13" Margin="0,0,0,6">
                                <Run Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_TurnTime], Mode=OneWay}"/>
                                <Run Text=": "/>
                                <Run Text="{Binding CustomTurnTime, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="s"/>
                            </TextBlock>
                            <Slider Minimum="5" Maximum="120"
                                    Value="{Binding CustomTurnTime}"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Style="{DynamicResource PastelSlider}"
                                    Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: preview for non-custom difficulties -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomMode}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🃏"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_SelectDifficulty]}"
                                   Style="{DynamicResource PastelTextBlock}"
                                   FontSize="14" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Start / Back buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Command="{Binding GoBackCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"
                        Style="{DynamicResource LinkButton}"
                        Margin="0,0,24,0"/>
                <Button Command="{Binding StartGameCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Play]}"
                        Style="{DynamicResource PastelButton}"
                        Height="44" Padding="32,0"
                        FontSize="15"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
