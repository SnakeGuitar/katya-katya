<UserControl x:Class="MemoryGame.Client.Views.Board.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MemoryGame.Client.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             d:DesignWidth="1280" d:DesignHeight="720">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/GameAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Derive from shared card style, add multiplayer-specific disable trigger -->
            <Style x:Key="GameCardButton" TargetType="Button" BasedOn="{StaticResource AnimatedCardButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsMyTurn,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="Opacity"   Value="0.85"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Active player panel -->
            <Style x:Key="PlayerPanelBorder" TargetType="Border">
                <Setter Property="Background"  Value="#08000000"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding"     Value="14,10"/>
                <Setter Property="Margin"      Value="0,0,0,6"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.7" To="1" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <Setter Property="Background" Value="{DynamicResource PastelPrimary}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoardRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="BoardRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="20" To="0" Duration="0:0:0.5"
                                     EasingFunction="{StaticResource QuadEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GlobalBackgroundSource}" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Interactive 2D Bokeh Dynamic Background Canvas -->

        <Grid x:Name="BoardRoot" Margin="16" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: Players ══ -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12"
                    CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Label_Players]}"
                               Style="{DynamicResource PastelTextBlock}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource PastelPrimary}"
                               Margin="0,0,0,10"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PlayerPanelBorder}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="RightClick"
                                                      Command="{Binding DataContext.VoteToKickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource DefaultFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text="  ⭐" FontSize="11">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentUser}" Value="False">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" FontSize="12" Opacity="0.75"
                                                   FontFamily="{DynamicResource DefaultFont}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PastelTextLight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="❤ "/>
                                            <Run Text="{Binding Score, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" FontSize="11" Opacity="0.65"
                                                   FontFamily="{DynamicResource DefaultFont}" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PastelTextLight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="⏱ "/>
                                            <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="2" Command="{Binding LeaveGameCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Leave]}"
                            Style="{DynamicResource LinkButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- ══ CENTER: Game Board ══ -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>
                <Viewbox Stretch="Uniform">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding BoardRows}" Columns="{Binding BoardColumns}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="90" Height="90" Margin="4"
                                        Style="{StaticResource GameCardButton}"
                                        Command="{Binding DataContext.FlipCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>

            <!-- ══ RIGHT: Chat ══ -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12"
                    CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Lobby_Label_Chat]}"
                               Style="{DynamicResource PastelTextBlock}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource PastelPrimary}"
                               Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Background="#04000000" CornerRadius="10"
                            Padding="8" Margin="0,0,0,8">
                        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{DynamicResource PastelTextBlock}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ChatMessage, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PastelTextBox}" FontSize="12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendChatMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Style="{DynamicResource PastelButton}"
                                Command="{Binding SendChatMessageCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Send]}"
                                Padding="12,4" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Particle Canvas: love-point hearts fly here on match -->
        <skia:SKElement x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <!-- ══ GAME OVER OVERLAY ══ -->
        <Border x:Name="GameOverOverlay"
                Visibility="{Binding ShowGameOver, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#DD000000" Opacity="0">
            <Border x:Name="GameOverCard"
                    Background="#F5E6E8"
                    CornerRadius="20" Padding="40,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360">
                <Border.RenderTransform>
                    <TranslateTransform Y="40"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="3x">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3"  Value="-15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="10"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.6"  Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="{Binding GameOverTitle}"
                               Style="{DynamicResource PastelHeading}"
                               FontSize="24" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,16"
                               Foreground="#E63946" FontWeight="Bold"/>

                    <TextBlock Text="{Binding GameOverStats}"
                               Style="{DynamicResource PastelTextBlock}"
                               FontSize="15" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,24"/>

                    <Button Command="{Binding CloseGameOverCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Accept]}"
                            Style="{DynamicResource PastelButton}"
                            Padding="28,10" FontSize="15" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
