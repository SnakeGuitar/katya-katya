<UserControl x:Class="MemoryGame.Client.Views.SinglePlayer.SinglePlayerGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MemoryGame.Client.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             d:DesignWidth="1280" d:DesignHeight="720">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/GameAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Derive from shared card style, add SP-specific disable trigger -->
            <Style x:Key="SPCardButton" TargetType="Button" BasedOn="{StaticResource AnimatedCardButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsInteractionEnabled,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="Opacity"   Value="0.85"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource PastelTextBlock}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Opacity"  Value="0.7"/>
                <Setter Property="Margin"   Value="0,0,0,2"/>
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource PastelTextBlock}">
                <Setter Property="FontSize"   Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
                <Setter Property="Margin"     Value="0,0,0,14"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoardRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="BoardRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="20" To="0" Duration="0:0:0.5"
                                     EasingFunction="{StaticResource QuadEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GlobalBackgroundSource}" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Interactive 2D Bokeh Dynamic Background Canvas -->

        <Grid x:Name="BoardRoot" Margin="16" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════ LEFT: Stats ══════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="18,16"
                    CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PlayerName}"
                                   Style="{DynamicResource PastelTextBlock}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Rectangle Style="{DynamicResource SectionDivider}" Margin="0,8,0,0" Height="1"/>
                    </StackPanel>

                    <StackPanel x:Name="StatsPanel" Grid.Row="1">
                        <!-- Love-points icon + label -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/Resources/Images/Icons/love-points.png"
                                   Width="22" Height="22" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Pairs]}"
                                       Style="{StaticResource StatLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock x:Name="ScoreText"
                                   Text="{Binding Score, NotifyOnTargetUpdated=True}"
                                   Style="{StaticResource StatValue}">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="1.4"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                      EasingFunction="{StaticResource ElasticEase}"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="1.4"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                      EasingFunction="{StaticResource ElasticEase}"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                            <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Attempts]}"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Attempts}" Style="{StaticResource StatValue}"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_TurnTime]}"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TurnTimerText" Text="{Binding TurnTimerDisplay}" Style="{StaticResource StatValue}"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Elapsed]}"
                                   Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding ElapsedDisplay}" Style="{StaticResource StatValue}"/>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Command="{Binding LeaveGameCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Leave]}"
                            Style="{DynamicResource LinkButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- ══════════════ CENTER: Game Board ══════════════ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>
                <Viewbox Stretch="Uniform">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding BoardRows}" Columns="{Binding BoardColumns}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="90" Height="90" Margin="4"
                                        Style="{StaticResource SPCardButton}"
                                        Command="{Binding DataContext.FlipCardCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Particle canvas -->
        <skia:SKElement x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <!-- ══════════════ GAME OVER OVERLAY ══════════════ -->
        <Border x:Name="GameOverOverlay"
                Visibility="{Binding ShowGameOver, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#DD000000" Opacity="0">
            <Border x:Name="GameOverCard"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="20" Padding="40,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380">
                <Border.RenderTransform>
                    <TranslateTransform Y="40"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="52"
                               HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="3x">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3"  Value="-15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="10"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.6"  Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="{Binding GameOverTitle}"
                               Style="{DynamicResource PastelHeading}" FontSize="24"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding GameOverStats}"
                               Style="{DynamicResource PastelTextBlock}" FontSize="14"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,0,0,28"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding PlayAgainCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_PlayAgain]}"
                                Style="{DynamicResource PastelButton}"
                                Padding="28,10" FontSize="15" Margin="0,0,12,0"/>
                        <Button Command="{Binding CloseGameOverCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Leave]}"
                                Style="{DynamicResource LinkButton}" FontSize="15"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
