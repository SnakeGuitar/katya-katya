<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         Shared Easing Functions
         ═══════════════════════════════════════════════════════════════ -->
    <QuadraticEase x:Key="QuadEase"    EasingMode="EaseInOut"/>
    <BounceEase    x:Key="BounceEase"  Bounces="2" Bounciness="3" EasingMode="EaseOut"/>
    <ElasticEase   x:Key="ElasticEase" Oscillations="2" Springiness="6" EasingMode="EaseOut"/>

    <!-- ═══════════════════════════════════════════════════════════════
         AnimatedCardButton
         Base card style with flip, hover-lift, match-bounce, and
         sparkle-ring animations.  Views derive from this style and
         add view-specific disable triggers via Style.Triggers.
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="AnimatedCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            CornerRadius="12"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource PastelPrimary}"
                            Background="{DynamicResource CardBackground}"
                            ClipToBounds="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="1.1" EnableClearType="False"/>
                        </Border.CacheMode>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FlipScale"  ScaleX="1" ScaleY="1"/>
                                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow"
                                              BlurRadius="8" ShadowDepth="2"
                                              Opacity="0.15"
                                              Color="{DynamicResource CardShadowColor}"/>
                        </Border.Effect>

                        <Grid>
                            <Image Source="{Binding DisplayImage}"
                                   Stretch="Uniform" Margin="6"
                                   RenderOptions.BitmapScalingMode="LowQuality"/>

                            <Border x:Name="MatchedOverlay"
                                    Background="{DynamicResource MatchOverlayBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed"/>

                            <Ellipse x:Name="MatchRing"
                                     Stroke="{DynamicResource MatchRingBrush}"
                                     StrokeThickness="3" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5"
                                     RenderOptions.EdgeMode="Aliased"
                                     CacheMode="BitmapCache">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <!-- Hover lift / shadow animations -->
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.08" Duration="0:0:0.10" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.08" Duration="0:0:0.10" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                         To="0.35" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.10" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.10" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                         To="0.15" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover border accent.
                             IMPORTANT: do NOT change BorderThickness here. Changing it invalidates
                             layout, which cascades through UniformGrid → Viewbox and forces every
                             card (with its DropShadowEffect) to re-render. Brush swap is render-only. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PastelAccent}"/>
                        </Trigger>

                        <!-- Flip squeeze -->
                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FlipIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipScale" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="0" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1" EasingFunction="{StaticResource QuadEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard x:Name="FlipOut">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipScale" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="0" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1" EasingFunction="{StaticResource QuadEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>

                        <!-- Match bounce + sparkle ring -->
                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipScale" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.2" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.9" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"   EasingFunction="{StaticResource QuadEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipScale" Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.2" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.9" EasingFunction="{StaticResource QuadEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"   EasingFunction="{StaticResource QuadEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.5" To="1.4" Duration="0:0:0.45" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.5" To="1.4" Duration="0:0:0.45" EasingFunction="{StaticResource QuadEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="MatchRing" Storyboard.TargetProperty="Opacity"
                                                         From="0.9" To="0" Duration="0:0:0.45"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <Setter Property="IsEnabled"                   Value="False"/>
                            <Setter TargetName="MatchedOverlay" Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity"                     Value="0.75"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
