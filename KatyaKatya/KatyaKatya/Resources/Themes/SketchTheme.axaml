<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         SKETCH / WIREFRAME PALETTE
         Monochrome, hand-drawn aesthetic with Pangolin/Comico fonts
         Overrides BaseTheme tokens when loaded
         ═══════════════════════════════════════════════════════════ -->

    <!-- Primary: Pure Black -->
    <Color x:Key="Color.Primary.50">#F0F0F0</Color>
    <Color x:Key="Color.Primary.100">#E0E0E0</Color>
    <Color x:Key="Color.Primary.300">#999999</Color>
    <Color x:Key="Color.Primary.500">#111111</Color>
    <Color x:Key="Color.Primary.600">#000000</Color>
    <Color x:Key="Color.Primary.700">#000000</Color>

    <!-- Secondary: Light grey -->
    <Color x:Key="Color.Secondary.300">#D0D0D0</Color>
    <Color x:Key="Color.Secondary.500">#EAEAEA</Color>
    <Color x:Key="Color.Secondary.600">#DDDDDD</Color>

    <!-- Neutral -->
    <Color x:Key="Color.Neutral.50">#FAFAFA</Color>
    <Color x:Key="Color.Neutral.100">#F5F5F5</Color>
    <Color x:Key="Color.Neutral.200">#EEEEEE</Color>
    <Color x:Key="Color.Neutral.300">#E0E0E0</Color>
    <Color x:Key="Color.Neutral.500">#9E9E9E</Color>
    <Color x:Key="Color.Neutral.600">#555555</Color>
    <Color x:Key="Color.Neutral.700">#333333</Color>
    <Color x:Key="Color.Neutral.900">#000000</Color>

    <!-- Surface -->
    <Color x:Key="Color.Surface.Background">#FAFAFA</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color>

    <!-- Semantic -->
    <Color x:Key="Color.Success">#1B5E20</Color>
    <Color x:Key="Color.Error">#B00020</Color>
    <Color x:Key="Color.Warning">#E65100</Color>

    <!-- ═══════════════════════════════════════════════════════════
         BRUSHES — Monochrome Solid
         ═══════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="PrimaryBrush"        Color="{StaticResource Color.Primary.500}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="{StaticResource Color.Primary.600}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="{StaticResource Color.Primary.50}"/>

    <SolidColorBrush x:Key="PastelPrimary"        Color="{StaticResource Color.Primary.500}"/>
    <SolidColorBrush x:Key="PastelPrimaryHover"   Color="{StaticResource Color.Primary.600}"/>
    <SolidColorBrush x:Key="PastelBackground"     Color="{StaticResource Color.Surface.Background}"/>
    <SolidColorBrush x:Key="PastelText"           Color="#000000"/>
    <SolidColorBrush x:Key="PastelTextLight"      Color="#555555"/>
    <SolidColorBrush x:Key="PastelError"          Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="PastelSuccess"        Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="LinkText"             Color="#000000"/>
    <SolidColorBrush x:Key="LinkTextHover"        Color="#555555"/>

    <SolidColorBrush x:Key="SecondaryBrush"      Color="{StaticResource Color.Secondary.500}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource Color.Secondary.600}"/>

    <SolidColorBrush x:Key="BackgroundBrush"     Color="{StaticResource Color.Surface.Background}"/>
    <SolidColorBrush x:Key="CardBrush"           Color="{StaticResource Color.Surface.Card}"/>
    <SolidColorBrush x:Key="DividerBrush"        Color="{StaticResource Color.Neutral.300}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource Color.Neutral.900}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource Color.Neutral.600}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource Color.Neutral.600}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"   Color="{StaticResource Color.Neutral.500}"/>

    <SolidColorBrush x:Key="SuccessBrush"        Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="ErrorBrush"          Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="{StaticResource Color.Warning}"/>

    <!-- ═══════════════════════════════════════════════════════════
         BRUSHES — Flat gradients (no glass in sketch mode)
         ═══════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="PastelSecondary"       Color="#EAEAEA"/>
    <SolidColorBrush x:Key="PastelAccent"          Color="#333333"/>
    <SolidColorBrush x:Key="PastelBorder"          Color="#111111"/>

    <SolidColorBrush x:Key="CardBackground"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryGradient"       Color="#111111"/>
    <SolidColorBrush x:Key="PrimaryGradientHover"  Color="#000000"/>
    <SolidColorBrush x:Key="ButtonPrimaryGradient" Color="#111111"/>
    <SolidColorBrush x:Key="ButtonSecondaryGradient" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ButtonAccentGradient"  Color="#D0D0D0"/>
    <SolidColorBrush x:Key="InputBackground"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundHover"  Color="#F5F5F5"/>

    <!-- Animation colours -->
    <SolidColorBrush x:Key="MatchRingBrush"     Color="#111111"/>
    <SolidColorBrush x:Key="MatchOverlayBrush"  Color="#30111111"/>
    <Color x:Key="CardShadowColor">#888888</Color>

    <!-- ═══════════════════════════════════════════════════════════
         TYPOGRAPHY — Pangolin (body) + Comico (display)
         Hand-drawn wireframe fonts
         ═══════════════════════════════════════════════════════════ -->

    <FontFamily x:Key="DefaultFont">avares://KatyaKatya/Resources/Fonts#Pangolin</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://KatyaKatya/Resources/Fonts#Comico</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════
         CORNER RADII — sharp wireframe edges
         ═══════════════════════════════════════════════════════════ -->

    <CornerRadius x:Key="ButtonCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>

    <CornerRadius x:Key="Radius.Card">4</CornerRadius>
    <CornerRadius x:Key="Radius.Button">3</CornerRadius>
    <CornerRadius x:Key="Radius.Input">3</CornerRadius>
    <CornerRadius x:Key="Radius.Small">2</CornerRadius>
    <CornerRadius x:Key="Radius.Full">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════
         SPACING
         ═══════════════════════════════════════════════════════════ -->

    <Thickness x:Key="Spacing.Xs">4</Thickness>
    <Thickness x:Key="Spacing.Sm">8</Thickness>
    <Thickness x:Key="Spacing.Md">16</Thickness>
    <Thickness x:Key="Spacing.Lg">24</Thickness>
    <Thickness x:Key="Spacing.Xl">32</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         BOX SHADOWS — sketch-style with stronger black borders
         ═══════════════════════════════════════════════════════════ -->

    <BoxShadows x:Key="Shadow.Card">2 2 0 0 #30000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Elevated">3 3 0 0 #40000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Subtle">1 1 0 0 #20000000</BoxShadows>

    <BoxShadows x:Key="Shadow.Neumorphic">3 3 0 0 #40000000</BoxShadows>
    <BoxShadows x:Key="Shadow.NeumorphicSoft">2 2 0 0 #30000000</BoxShadows>
    <BoxShadows x:Key="Shadow.NeumorphicInset">1 1 0 0 #25000000</BoxShadows>

    <BoxShadows x:Key="Shadow.GlassCard">3 3 0 0 #35000000</BoxShadows>

    <BoxShadows x:Key="Shadow.ButtonGlow">2 2 0 0 #40000000</BoxShadows>
    <BoxShadows x:Key="Shadow.ButtonGlowHover">3 3 0 0 #55000000</BoxShadows>

    <!-- Menu Toggle Icon Source -->
    <Bitmap x:Key="MenuIconSource">avares://KatyaKatya/Resources/Images/Icons/sketch-menu-icon.png</Bitmap>

</ResourceDictionary>
