<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         GLOBAL FONT DEFAULT — Nunito everywhere
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
    </Style>
    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTON CLASSES — Premium glassmorphic buttons
         ═══════════════════════════════════════════════════════════ -->

    <!-- .btn-primary: warm rose gradient with scale + glow + shimmer -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform" Value="scale(1.0)"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_ContentPresenterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource Shadow.ButtonGlow}"
                        ClipToBounds="True">
                    <Panel>
                        <!-- Inner Glint Highlight (Rim Reflection on glass top lip) -->
                        <Border BorderBrush="#4DFFFFFF"
                                BorderThickness="0,1.2,0,0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"/>

                        <!-- Inner Dark Edge Shadow (Simulating physical thickness) -->
                        <Border BorderBrush="#25000000"
                                BorderThickness="0,0,0,1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"/>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <!-- Shimmer sweep overlay (WPF parity: glint that sweeps on hover) -->
                        <Border x:Name="Shimmer"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="-120,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#60FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- BoxShadow animated transition on the border (WPF parity: glow Color+BlurRadius animation) -->
    <Style Selector="Button.btn-primary /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-primary:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ButtonGlowHover}"/>
    </Style>
    <!-- Base RenderTransform on Shimmer so animation property path TranslateTransform.X resolves -->
    <Style Selector="Button.btn-primary /template/ Border#Shimmer">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0"/>
        </Setter>
    </Style>
    <!-- Shimmer sweep animation on hover (WPF parity: TranslateTransform X -50→400 over 0.6s) -->
    <Style Selector="Button.btn-primary:pointerover /template/ Border#Shimmer">
        <Style.Animations>
            <Animation Duration="0:0:0.65" FillMode="None">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-50"/>
                </KeyFrame>
                <KeyFrame Cue="8%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="-30"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="400"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.btn-primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.btn-primary:disabled">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- .btn-secondary: translucent rose glassmorphic -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform" Value="scale(1.0)"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_ContentPresenterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource Shadow.NeumorphicSoft}">
                    <Panel>
                        <!-- Inner Glint Highlight -->
                        <Border BorderBrush="#4DFFFFFF" 
                                BorderThickness="0,1.2,0,0" 
                                CornerRadius="{TemplateBinding CornerRadius}" 
                                IsHitTestVisible="False"/>

                        <!-- Inner Dark Edge Shadow -->
                        <Border BorderBrush="#15000000" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="{TemplateBinding CornerRadius}" 
                                IsHitTestVisible="False"/>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.btn-secondary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- .btn-accent: elegant warm pink glass -->
    <Style Selector="Button.btn-accent">
        <Setter Property="Background" Value="{DynamicResource ButtonAccentGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform" Value="scale(1.0)"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_ContentPresenterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource Shadow.NeumorphicSoft}">
                    <Panel>
                        <!-- Inner Glint Highlight -->
                        <Border BorderBrush="#4DFFFFFF" 
                                BorderThickness="0,1.2,0,0" 
                                CornerRadius="{TemplateBinding CornerRadius}" 
                                IsHitTestVisible="False"/>

                        <!-- Inner Dark Edge Shadow -->
                        <Border BorderBrush="#15000000" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="{TemplateBinding CornerRadius}" 
                                IsHitTestVisible="False"/>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.btn-accent:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.btn-accent:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- .btn-ghost: transparent with colored text (WPF LinkButton equivalent) -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
    </Style>
    <Style Selector="Button.btn-ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource LinkTextHover}"/>
    </Style>

    <!-- .btn-danger: red outline, fills on hover -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Shadow.NeumorphicSoft}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradient}"/>
    </Style>
    <Style Selector="Button.btn-danger:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- .btn-success: green tint -->
    <Style Selector="Button.btn-success">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="#1B4332"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform" Value="scale(1.0)"/>
    </Style>
    <Style Selector="Button.btn-success /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Button}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-success:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.btn-success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#6FC48C"/>
    </Style>
    <Style Selector="Button.btn-success:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- .btn-dropdown: transparent, radius hover (for menu popups) -->
    <Style Selector="Button.btn-dropdown">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-dropdown /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-dropdown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PastelSecondary}"/>
    </Style>
    <Style Selector="Button.btn-dropdown:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
    </Style>
    <Style Selector="Button.btn-dropdown:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PastelAccent}"/>
    </Style>

    <!-- .menu-toggle: Top-right aligned round menu button matching WPF MenuToggleBtn -->
    <Style Selector="ToggleButton.menu-toggle">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.menu-toggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.menu-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#22000000"/>
    </Style>
    <Style Selector="ToggleButton.menu-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#44000000"/>
    </Style>

    <!-- .headerBtn: header bar buttons (subtle) -->
    <Style Selector="Button.headerBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.headerBtn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.headerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#22000000"/>
    </Style>

    <!-- All buttons: scale transition -->
    <Style Selector="Button.btn-primary, Button.btn-secondary, Button.btn-accent, Button.btn-success, Button.btn-danger">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CARDS — Glassmorphic containers
         ═══════════════════════════════════════════════════════════ -->

    <!-- .card: standard card with shadow and fade-in -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Card}"/>
        <Setter Property="Padding" Value="24"/>
        <Style.Animations>
            <Animation Duration="0:0:0.25" Delay="0:0:0.05" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- .glass-card: Liquid Glass Card (WPF LiquidGlassCard equivalent) -->
    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassCard}"/>
        <Setter Property="Padding" Value="32,28,32,24"/>
    </Style>

    <!-- .card-subtle: subtle shadow card -->
    <Style Selector="Border.card-subtle">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Subtle}"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Animations>
            <Animation Duration="0:0:0.25" Delay="0:0:0.05" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TYPOGRAPHY
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelTextLight}"/>
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelTextLight}"/>
    </Style>

    <Style Selector="TextBlock.error-text">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelError}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         INPUT — Carved Inset Glass TextBox
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="TextBox.input">
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InputCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PastelText}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- Main carved border container with shadow -->
                    <Border x:Name="PART_BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="PART_Watermark"
                                       Text="{TemplateBinding Watermark}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                       Opacity="0.5"
                                       FontStyle="Italic"
                                       Foreground="{TemplateBinding Foreground}"
                                       IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                    <!-- Top-lip inner shadow (adds carving pocket depth) -->
                    <Border BorderBrush="#1F000000" 
                            BorderThickness="0,1.2,0,0" 
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"/>
                    <!-- Bottom-lip glint highlight (adds refractive shelf light reflection) -->
                    <Border BorderBrush="#40FFFFFF" 
                            BorderThickness="0,0,0,1" 
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox.input /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="BoxShadow" Value="0 0 10 0 #99FF8080"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    </Style>
    <Style Selector="TextBox.input:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
    </Style>
    <Style Selector="TextBox.input:disabled">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TOGGLE SWITCH — Pill-shaped CheckBox
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="ToggleSwitch.themed">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OnContent" Value="On"/>
        <Setter Property="OffContent" Value="Off"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         COMBOBOX — Themed with warm rose accents
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="ComboBox.themed">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InputCornerRadius}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox.themed:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource PastelPrimary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SLIDER — Warm rose themed
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="Slider.themed">
        <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION DIVIDER
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="Rectangle.divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource PastelBorder}"/>
        <Setter Property="Margin" Value="0,16,0,16"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         PAGE BACKGROUND (for UserControl root grids)
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="Grid.page-bg">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Animations>
            <Animation Duration="0:0:0.3" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.page-bg">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Animations>
            <Animation Duration="0:0:0.3" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TRAFFIC LIGHT BUTTONS (macOS-style window controls)
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="Button.traffic-light">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.traffic-light /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.traffic-close">
        <Setter Property="Background" Value="#FF5F56"/>
    </Style>
    <Style Selector="Button.traffic-close /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF5F56"/>
    </Style>
    <Style Selector="Button.traffic-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E04E45"/>
    </Style>

    <Style Selector="Button.traffic-minimize">
        <Setter Property="Background" Value="#FFBD2E"/>
    </Style>
    <Style Selector="Button.traffic-minimize /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFBD2E"/>
    </Style>
    <Style Selector="Button.traffic-minimize:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E6A925"/>
    </Style>

    <Style Selector="Button.traffic-maximize">
        <Setter Property="Background" Value="#27C93F"/>
    </Style>
    <Style Selector="Button.traffic-maximize /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#27C93F"/>
    </Style>
    <Style Selector="Button.traffic-maximize:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1FB335"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         GAME CARD BUTTON
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="Button.card-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="QuadraticEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.card-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.card-btn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.08)"/>
    </Style>
    <Style Selector="Button.card-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         STAT LABELS (for game view)
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector="TextBlock.stat-label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style Selector="TextBlock.stat-value">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PastelPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

</Styles>
