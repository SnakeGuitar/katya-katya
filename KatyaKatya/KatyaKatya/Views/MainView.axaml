<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KatyaKatya.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="KatyaKatya.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <Panel>
        <!-- Main content: current view resolved by ViewLocator -->
        <TransitioningContentControl Content="{Binding Navigation.CurrentViewModel}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2"/>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Header (visible when not in session flow) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Spacing="8"
                    IsVisible="{Binding IsHeaderVisible}">
            <Button Content="Settings" Command="{Binding GoToSettingsCommand}"/>
            <Button Content="Profile" Command="{Binding GoToProfileCommand}"/>
        </StackPanel>
    </Panel>
</UserControl>
