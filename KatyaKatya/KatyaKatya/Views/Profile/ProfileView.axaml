<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Profile"
             xmlns:converters="using:KatyaKatya.Converters"
             x:Class="KatyaKatya.Views.Profile.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <UserControl.Resources>
        <converters:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter"/>
    </UserControl.Resources>

    <Grid Classes="page-bg" RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="24,24,24,24">
            <Button Grid.Column="0" Command="{Binding GoBackCommand}" Classes="btn-ghost" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="←" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="My Profile" Classes="h2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding LogoutCommand}" Classes="btn-ghost" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🚪" VerticalAlignment="Center"/>
                    <TextBlock Text="Logout" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="24,0,24,24">
            <Grid ColumnDefinitions="*, 32, 1.2*" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Top">
                
                <!-- Left Column: Avatar & Quick Actions (Grid.Column="0") -->
                <StackPanel Grid.Column="0" Spacing="24">
                    <Border Classes="card">
                        <StackPanel Spacing="20" HorizontalAlignment="Center">
                            <!-- Circular Avatar Box -->
                            <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                <Border CornerRadius="70" ClipToBounds="True" Background="{DynamicResource PrimaryLightBrush}">
                                    <TextBlock Text="👤" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Border CornerRadius="70" ClipToBounds="True" IsVisible="{Binding AvatarBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding AvatarBytes, Converter={StaticResource ByteArrayToBitmapConverter}}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>

                            <!-- Profile Name Tags -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Username}" Classes="h3" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Email}" Classes="subtitle" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                            <!-- Quick Stats / Registration -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Member Since" Classes="label" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RegistrationDate}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Action Panel -->
                    <Border Classes="card-subtle">
                        <StackPanel Spacing="12">
                            <Button Command="{Binding GoToEditProfileCommand}" Classes="btn-primary" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="✏️" VerticalAlignment="Center"/>
                                    <TextBlock Text="Edit Profile" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding GoToFriendsCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="👥" VerticalAlignment="Center"/>
                                    <TextBlock Text="Friends Hub" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Full Profile Details & Social Accounts (Grid.Column="2") -->
                <StackPanel Grid.Column="2" Spacing="24">
                    <!-- Personal Info Card -->
                    <Border Classes="card">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Personal Details" Classes="h3" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                            <Grid RowDefinitions="Auto, 16, Auto" ColumnDefinitions="*, 16, *">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="First &amp; Last Name" Classes="label"/>
                                    <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Username" Classes="label"/>
                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                                    <TextBlock Text="Email Address" Classes="label"/>
                                    <TextBlock Text="{Binding Email}" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Linked Social Networks -->
                    <Border Classes="card">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Linked Social Accounts" Classes="h3" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                            <!-- When accounts exist -->
                            <StackPanel IsVisible="{Binding HasSocialNetworks}" Spacing="12">
                                <ItemsControl ItemsSource="{Binding SocialNetworks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="🔗" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Account}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Connected" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Empty state -->
                            <StackPanel IsVisible="{Binding !HasSocialNetworks}" Spacing="16" Margin="0,16" HorizontalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="36" Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="No social accounts linked yet." Classes="subtitle" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Loading Profile..." Classes="subtitle" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
