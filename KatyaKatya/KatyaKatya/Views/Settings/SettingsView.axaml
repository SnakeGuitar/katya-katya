<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Settings"
             x:Class="KatyaKatya.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid>
        <!-- Dual Column Layout: Logo on the left (50/50 split), Settings Card on the right -->
        <Grid ColumnDefinitions="*, *">
            
            <!-- LEFT: Logo Column -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoImageControl"
                       Classes="logo-breathing"
                       Width="280"
                       Stretch="Uniform"
                       Margin="40,0,0,0"/>
            </Grid>

            <!-- RIGHT: Settings Card Column -->
            <Border Grid.Column="1" Classes="glass-card"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="400"
                    Padding="36,32"
                    Margin="0,0,40,0">
                
                <StackPanel Spacing="20">
                    <!-- Heading -->
                    <TextBlock Text="Settings"
                               Classes="h2"
                               FontFamily="{DynamicResource DisplayFont}"
                               Foreground="{DynamicResource PastelPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <!-- Options Grid -->
                    <StackPanel Spacing="16">
                        
                        <!-- ── Language ── -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Language" Classes="label"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Classes="themed"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                        <!-- ── Theme ── -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Theme" Classes="label"/>
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Classes="themed"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                        <!-- ── Screen Mode ── -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Fullscreen Mode (F11)" Classes="label" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="themed"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding IsFullscreen}"
                                          Margin="0"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4"/>

                        <!-- ── Music Toggle ── -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Background Music" Classes="label" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="themed"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding IsMusicEnabled}"
                                          Margin="0"/>
                        </Grid>

                        <!-- ── Music Track (Only visible if Music is enabled) ── -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsMusicEnabled}">
                            <TextBlock Text="Select Track" Classes="label"/>
                            <ComboBox ItemsSource="{Binding AvailableTracks}"
                                      SelectedIndex="{Binding SelectedTrackIndex}"
                                      Classes="themed"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- ── Volume (Only visible if Music is enabled) ── -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsMusicEnabled}">
                            <TextBlock Text="Volume" Classes="label"/>
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0"
                                           Text="🔊"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           FontSize="16"/>
                                <Slider Grid.Column="1"
                                        Classes="themed"
                                        Value="{Binding MusicVolume}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                    <!-- Back Button -->
                    <Button Content="Go Back"
                            Command="{Binding GoBackCommand}"
                            Classes="btn-ghost"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
