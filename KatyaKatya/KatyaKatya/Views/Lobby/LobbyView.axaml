<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Lobby"
             xmlns:models="using:KatyaKatya.Models.Lobby"
             x:Class="KatyaKatya.Views.Lobby.LobbyView"
             x:DataType="vm:LobbyViewModel">

    <UserControl.Styles>
        <!-- Hover scale effect for player rows and interactive elements -->
        <Style Selector="Border.player-row">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>
        <Style Selector="Border.player-row:pointerover">
            <Setter Property="Background" Value="#0D000000"/>
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>

        <Style Selector="Button.kick-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.kick-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Main Card Wrapper -->
        <Border Classes="card" MaxWidth="920" MinWidth="760" MinHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- ══ Header Section ══ -->
                <Grid Grid.Row="0" ColumnDefinitions="*, 24, Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Multiplayer Lobby" Classes="h2" Foreground="{DynamicResource SecondaryBrush}"/>
                        <TextBlock Text="Wait for the host to configure settings and launch the match" Classes="subtitle"/>
                    </StackPanel>

                    <!-- Game Code Badge with elegant design -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="16"
                            Padding="20,10"
                            BoxShadow="0 4 12 0 #30E7726A"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="GAME CODE:"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Opacity="0.8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GameCode}"
                                       FontSize="22"
                                       FontWeight="Black"
                                       Foreground="White"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="0" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>

                <!-- ══ Main Content Area (Lobby panels) ══ -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 24, *" Margin="0,16,0,0">
                    
                    <!-- LEFT: Player List Panel -->
                    <Border Grid.Column="0"
                            Background="#06000000"
                            CornerRadius="14"
                            Padding="16,14">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0"
                                       Text="Players in Lobby"
                                       Classes="h3"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- Empty state when no players are loaded -->
                            <StackPanel Grid.Row="1" 
                                        IsVisible="{Binding !HasPlayers}"
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center" 
                                        Spacing="12">
                                <TextBlock Text="👤" FontSize="36" Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waiting for players to join..."
                                           Classes="subtitle"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Scrollable Player List -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasPlayers}">
                                <ItemsControl ItemsSource="{Binding Players}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LobbyPlayerDto">
                                            <Border Classes="player-row"
                                                    Background="#08000000"
                                                    CornerRadius="10"
                                                    Padding="14,10"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalAlignment="Center">
                                                    <!-- Avatar icon inside stylized circle -->
                                                    <Border Grid.Column="0"
                                                            Width="36" Height="36"
                                                            CornerRadius="18"
                                                            Background="{DynamicResource PrimaryLightBrush}"
                                                            Margin="0,0,12,0">
                                                        <TextBlock Text="👤"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Player details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Username}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Guest Player"
                                                                   Classes="label"
                                                                   FontSize="10"
                                                                   Opacity="0.5"
                                                                   IsVisible="{Binding IsGuest}"/>
                                                    </StackPanel>

                                                    <!-- Host indicator crown -->
                                                    <Border Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0"
                                                            IsVisible="{Binding IsHost}">
                                                        <TextBlock Text="👑"
                                                                   FontSize="16"
                                                                   ToolTip.Tip="Lobby Creator"/>
                                                    </Border>

                                                    <!-- Vote Kick Player Action (visible only for non-hosts) -->
                                                    <Button Grid.Column="3"
                                                            Classes="btn-ghost kick-btn"
                                                            Width="28" Height="28"
                                                            Padding="0"
                                                            FontSize="12"
                                                            Content="⚑"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsHost}"
                                                            Command="{Binding $parent[UserControl].((vm:LobbyViewModel)DataContext).VoteToKickCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Vote to kick player"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Chat Box Panel -->
                    <Border Grid.Column="2"
                            Background="#06000000"
                            CornerRadius="14"
                            Padding="16,14">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Row="0"
                                       Text="Lobby Chat"
                                       Classes="h3"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- Scrollable Chat Messages list -->
                            <Border Grid.Row="1"
                                    Background="#04000000"
                                    CornerRadius="10"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <ScrollViewer x:Name="ChatScrollViewer"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           Classes="subtitle"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Bottom Chat Input row -->
                            <Grid Grid.Row="2" ColumnDefinitions="*, 8, Auto">
                                <TextBox Grid.Column="0"
                                         Classes="input"
                                         Text="{Binding ChatMessage, Mode=TwoWay}"
                                         PlaceholderText="Type a message..."
                                         VerticalAlignment="Center">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SendChatMessageCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <Button Grid.Column="2"
                                        Classes="btn-secondary"
                                        Content="Send"
                                        Command="{Binding SendChatMessageCommand}"
                                        Padding="16,8"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══ Footer Section ══ -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,16,0,0">
                    <Button Grid.Column="0"
                            Classes="btn-ghost"
                            Command="{Binding LeaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚪" VerticalAlignment="Center"/>
                            <TextBlock Text="Leave Lobby" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Host Start Status indicator with elegant visual pulse effect -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="2" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Waiting for host to start..."
                                   Classes="subtitle"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Loading Overlay (Shown when match is starting or setting up) -->
        <Grid Background="#B0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Initializing game board..." Classes="h3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait while assets are loaded..." Classes="subtitle" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
