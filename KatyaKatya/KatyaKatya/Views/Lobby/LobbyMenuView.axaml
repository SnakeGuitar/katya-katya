<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Lobby"
             xmlns:models="using:KatyaKatya.Models.Lobby"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="KatyaKatya.Views.Lobby.LobbyMenuView"
             x:DataType="vm:LobbyMenuViewModel">

    <UserControl.Styles>
        <Style Selector="Button.lobby-item">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#FFF0EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5D0D0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lobby-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFEAE7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Classes="page-bg" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Multiplayer Game"
                       Classes="h2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Two-column Layout -->
            <Grid Grid.Row="1" ColumnDefinitions="320, 24, 480">

                <!-- ══════════════ LEFT COLUMN: Create & Join ══════════════ -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- CREATE LOBBY -->
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Host Game"
                                       Classes="h3"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <CheckBox IsChecked="{Binding IsPublic}"
                                      Content="Make Lobby Public"
                                      HorizontalAlignment="Center"
                                      IsEnabled="{Binding !IsGuest}"/>

                            <Button Command="{Binding CreateLobbyCommand}"
                                    Content="Create Lobby"
                                    Classes="btn-primary"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsLoading}"/>

                            <!-- Guest Warn -->
                            <TextBlock Text="Guest accounts cannot host public lobbies. Register to unlock full features."
                                       FontSize="11"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsVisible="{Binding IsGuest}"/>
                        </StackPanel>
                    </Border>

                    <!-- JOIN BY CODE -->
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Join by Code"
                                       Classes="h3"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBox Text="{Binding JoinCode}"
                                     PlaceholderText="Enter 6-digit code"
                                     MaxLength="6"
                                     HorizontalContentAlignment="Center"
                                     FontSize="16"
                                     Classes="input"/>

                            <Button Command="{Binding JoinByCodeCommand}"
                                    Content="Join Lobby"
                                    Classes="btn-secondary"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsLoading}"/>

                            <!-- Join Code Error -->
                            <TextBlock Text="{Binding JoinCodeError}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding JoinCodeError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ══════════════ RIGHT COLUMN: Public Lobbies ══════════════ -->
                <Border Grid.Column="2" Classes="card" Padding="20">
                    <DockPanel>
                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Public Lobbies"
                                   Classes="h3"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Empty State -->
                        <TextBlock Text="No active public lobbies. Host one to play with friends!"
                                   IsVisible="{Binding !PublicLobbies.Count}"
                                   FontSize="13"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <!-- Lobby List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PublicLobbies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LobbySummaryDto">
                                        <Button Classes="lobby-item"
                                                Command="{Binding $parent[UserControl].((vm:LobbyMenuViewModel)DataContext).JoinPublicLobbyCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding GameCode}"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="11" Opacity="0.6">
                                                        <Run Text="Host: "/><Run Text="{Binding HostUsername, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Players count badge -->
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PrimaryBrush}">
                                                        <Run Text="{Binding CurrentPlayers, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding MaxPlayers, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- Back -->
            <Button Grid.Row="2"
                    Command="{Binding GoBackCommand}"
                    Content="Back to Menu"
                    Classes="btn-ghost"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"/>

        </Grid>
    </Grid>
</UserControl>
