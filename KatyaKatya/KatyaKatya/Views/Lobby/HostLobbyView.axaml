<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Lobby"
             x:Class="KatyaKatya.Views.Lobby.HostLobbyView"
             x:DataType="vm:HostLobbyViewModel">

    <Grid>
        <Image Source="avares://KatyaKatya/Resources/Images/Backgrounds/background-minimalistic.png"
               Stretch="UniformToFill" IsHitTestVisible="False"/>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: players + settings + start -->
            <Border Grid.Column="0" Classes="LiquidGlassCard" Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with game code -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                        <TextBlock Text="Host Lobby"
                                   Classes="PastelHeading"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Game Code:" Classes="PastelLabel" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GameCode}"
                                       Classes="PastelHeading"
                                       FontSize="22"
                                       Foreground="{DynamicResource PastelPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Players list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0">
                            <TextBlock Text="Players" Classes="PastelLabel" FontSize="14" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="👤" FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Username}"
                                                       Classes="PastelTextBlock"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="HOST"
                                                       Classes="PastelLabel"
                                                       Foreground="{DynamicResource PastelPrimary}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsHost}"
                                                       Margin="8,0"/>
                                            <Button Grid.Column="3"
                                                    Classes="PastelButtonDanger"
                                                    Height="28" Padding="10,0"
                                                    FontSize="12"
                                                    IsVisible="{Binding !IsHost}"
                                                    Command="{Binding $parent[UserControl].DataContext.KickPlayerCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Kick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Game settings + actions -->
                    <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
                        <Rectangle Classes="SectionDivider" Height="1"/>

                        <TextBlock Text="Card Count" Classes="PastelLabel" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CardCountOptions}"
                                  SelectedItem="{Binding SelectedCardCount}"
                                  Classes="PastelComboBox"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="PastelButton"
                                    Height="44" Padding="24,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding StartGameCommand}"
                                    IsEnabled="{Binding HasPlayers}"
                                    Content="Start Game"/>
                            <Button Classes="LinkButton"
                                    Command="{Binding LeaveCommand}"
                                    Content="← Leave"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: chat -->
            <Border Grid.Column="2" Classes="LiquidGlassCard" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Chat"
                               Classes="PastelLabel" FontSize="14"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Classes="PastelTextBlock"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ChatMessage}"
                                 Classes="PastelTextBox"
                                 PlaceholderText="Message…"/>
                        <Button Grid.Column="1"
                                Classes="PastelButton"
                                Height="40" Padding="14,0"
                                Margin="6,0,0,0"
                                Command="{Binding SendChatMessageCommand}"
                                Content="→"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
