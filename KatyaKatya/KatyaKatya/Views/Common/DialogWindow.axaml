<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KatyaKatya.ViewModels.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="KatyaKatya.Views.Common.DialogWindow"
        x:DataType="vm:DialogViewModel"
        Title="{Binding Title}" Height="200" Width="400"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource PastelBorder}"
            BorderThickness="1.5"
            CornerRadius="{DynamicResource CardCornerRadius}"
            BoxShadow="{DynamicResource Shadow.GlassCard}"
            Margin="10">

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PastelPrimary}"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Left"/>

            <!-- Message -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Foreground="{DynamicResource PastelText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <!-- Buttons bar -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Spacing="8">

                <Button Content="OK"
                        Command="{Binding OKCommand}"
                        IsVisible="{Binding IsOkVisible}"
                        Classes="btn-primary"
                        MinWidth="80" Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsCancelVisible}"
                        Classes="btn-secondary"
                        MinWidth="80" Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                <Button Content="Yes"
                        Command="{Binding YesCommand}"
                        IsVisible="{Binding IsYesNoVisible}"
                        Classes="btn-primary"
                        MinWidth="80" Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                <Button Content="No"
                        Command="{Binding NoCommand}"
                        IsVisible="{Binding IsYesNoVisible}"
                        Classes="btn-secondary"
                        MinWidth="80" Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
