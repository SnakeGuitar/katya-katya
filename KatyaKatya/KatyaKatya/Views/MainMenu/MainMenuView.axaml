<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.MainMenu"
             x:Class="KatyaKatya.Views.MainMenu.MainMenuView"
             x:DataType="vm:MainMenuViewModel">

    <UserControl.Styles>
        <!-- Hover zoom effect for the Mood Character Cutout -->
        <Style Selector="Image.mood-char">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>
        <Style Selector="Image.mood-char:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>

        <!-- Clickable character container without default button styling -->
        <Style Selector="Button.char-clicker">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Main Horizontal Split Layout -->
        <Grid ColumnDefinitions="*, *">
            <!-- Left Column: Logo and Navigation Cards -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Width="460"
                        Margin="80,0,0,0"
                        Spacing="16">

                <!-- Floating Breathing Logo -->
                <Image Classes="logo-breathing"
                       Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                       Height="220"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>

                <!-- Interactive Glassmorphic Navigation Card (with cursor glow overlay) -->
                <Border x:Name="NavCardBorder"
                        Classes="glass-card"
                        Padding="0"
                        ClipToBounds="True"
                        PointerMoved="NavCardBorder_PointerMoved"
                        PointerEntered="NavCardBorder_PointerEntered"
                        PointerExited="NavCardBorder_PointerExited">
                    <Panel>
                        <!-- Cursor-tracking glow overlay (WPF parity: RadialGradientBrush follows mouse) -->
                        <Border x:Name="GlowOverlay"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5"
                                                     GradientOrigin="0.5,0.5">
                                    <GradientStop Color="#D5FFFFFF" Offset="0"/>
                                    <GradientStop Color="#65FFB6C1" Offset="0.4"/>
                                    <GradientStop Color="#25FFD1DC" Offset="0.8"/>
                                    <GradientStop Color="#00FFD1DC" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Actual content -->
                        <Border Padding="32,28,32,24">
                            <StackPanel Spacing="12">

                                <TextBlock Text="{Binding WelcomeMessage}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PastelPrimary}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <Button Content="Single Player"
                                        Command="{Binding GoToSingleplayerCommand}"
                                        Classes="btn-primary"
                                        Height="48"
                                        HorizontalAlignment="Stretch"/>

                                <Button Content="Multiplayer"
                                        Command="{Binding GoToMultiplayerCommand}"
                                        Classes="btn-primary"
                                        Height="48"
                                        HorizontalAlignment="Stretch"/>

                                <Button Content="More Menu"
                                        Command="{Binding GoToMoreCommand}"
                                        Classes="btn-primary"
                                        Height="48"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Rectangle Classes="divider" Margin="20,0,20,4"/>

                                <Button Content="Logout"
                                        Command="{Binding LogoutCommand}"
                                        Classes="btn-ghost"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Panel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,20,-20">
                <Button Classes="char-clicker"
                        Command="{Binding GoToDatingCommand}">
                    <Image Classes="mood-char"
                           Source="{Binding CurrentMoodImage}"
                           Height="660"
                           Stretch="Uniform"
                           Cursor="Hand"
                           ToolTip.Tip="Story Mode"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
