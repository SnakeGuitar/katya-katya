<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="KatyaKatya.Views.Session.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid>
        <!-- Main Grid with 50/50 Split Columns matching WPF exactly -->
        <Grid ColumnDefinitions="*, *">
            <!-- Left Column: Beautiful Centered Floating Logo (280x280) -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Classes="logo-breathing"
                       Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                       Width="280" Height="280"
                       Stretch="Uniform"
                       Margin="40,0,0,0"/>
            </Grid>

            <Border Grid.Column="1" Classes="glass-card"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="360" Padding="36,32" Margin="0,0,40,0">
                <StackPanel>
                    <TextBlock Text="Login" Classes="h2"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Username -->
                    <TextBlock Text="Username" Classes="label" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username}"
                             Classes="input"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,16"/>

                    <!-- Password -->
                    <TextBlock Text="Password" Classes="label" Margin="0,0,0,6"/>
                    <TextBox PasswordChar="●"
                             Text="{Binding Password}"
                             Classes="input"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,16"/>

                    <!-- Error feedback -->
                    <TextBlock Text="{Binding ErrorMessage}" Classes="error-text"
                               Margin="0,0,0,14"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Login button -->
                    <Button Content="Login" Command="{Binding LoginCommand}"
                            Classes="btn-primary" Height="46" HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"/>

                    <!-- Back link -->
                    <Button Content="Back" Command="{Binding GoBackCommand}"
                            Classes="btn-ghost" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
