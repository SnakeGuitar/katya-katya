<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="KatyaKatya.Views.Session.GuestLoginView"
             x:DataType="vm:GuestLoginViewModel">

    <Grid>
        <Grid ColumnDefinitions="*, *">
            <!-- Left: Logo -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Classes="logo-breathing"
                       Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                       Width="280" Height="280"
                       Stretch="Uniform"
                       Margin="40,0,0,0"/>
            </Grid>

            <!-- Right: Guest Login Card -->
            <Border Grid.Column="1" Classes="glass-card"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="360" Padding="36,32" Margin="0,0,40,0">
                <StackPanel>
                    <TextBlock Text="Play as Guest" Classes="h2"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Choose a username to start playing without an account."
                               Classes="subtitle"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Username" Classes="label" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username}"
                             Classes="input"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Classes="error-text"
                               Margin="0,0,0,14"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                    <Button Content="Continue as Guest" Command="{Binding LoginAsGuestCommand}"
                            Classes="btn-primary" Height="46" HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"/>

                    <Button Content="Back" Command="{Binding GoBackCommand}"
                            Classes="btn-ghost" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
