<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             x:Class="KatyaKatya.Views.Session.TitleScreenView"
             x:DataType="vm:TitleScreenViewModel">

    <Grid>
        <!-- Falling Petals Canvas placeholder (SkiaSharp phase) -->
        <Canvas Name="PetalCanvas" IsHitTestVisible="False"/>

        <!-- Floating Breathing Logo centered at top -->
        <Image Classes="logo-breathing"
               Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Width="200" Height="200"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Stretch="Uniform"
               Margin="0,-10,0,0"/>

        <!-- Centered Button Stack Panel exactly matching WPF -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="215"
                    Margin="0,80,0,0">

            <Button Height="40"
                    Margin="0,0,0,16"
                    Classes="btn-primary"
                    Command="{Binding GoToLoginCommand}"
                    Content="Login"
                    HorizontalAlignment="Stretch"/>

            <Button Height="40"
                    Margin="0,0,0,16"
                    Classes="btn-primary"
                    Command="{Binding GoToRegisterCommand}"
                    Content="Register"
                    HorizontalAlignment="Stretch"/>

            <Button Height="34"
                    Classes="btn-ghost"
                    Command="{Binding GoToGuestLoginCommand}"
                    Content="Continue as Guest"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
