<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="KatyaKatya.Views.Session.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid>
        <!-- Main Grid with 50/50 Split Columns matching WPF exactly -->
        <Grid ColumnDefinitions="*, *">
            <!-- Left Column: Beautiful Centered Floating Logo (280x280) -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Classes="logo-breathing"
                       Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                       Width="280" Height="280"
                       Stretch="Uniform"
                       Margin="40,0,0,0"/>
            </Grid>

            <Border Grid.Column="1" Classes="glass-card"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="360" Padding="36,32" Margin="0,0,40,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Create Account" Classes="h2"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <!-- Username -->
                        <TextBlock Text="Username" Classes="label" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Username}" Classes="input" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                        <!-- Email -->
                        <TextBlock Text="Email" Classes="label" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Email}" Classes="input" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                        <!-- Password -->
                        <TextBlock Text="Password" Classes="label" Margin="0,0,0,6"/>
                        <TextBox PasswordChar="●" Text="{Binding Password}" Classes="input" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                        <!-- Confirm Password -->
                        <TextBlock Text="Confirm Password" Classes="label" Margin="0,0,0,6"/>
                        <TextBox PasswordChar="●" Text="{Binding ConfirmPassword}" Classes="input" HorizontalAlignment="Stretch" Margin="0,0,0,18"/>

                        <!-- Error -->
                        <TextBlock Text="{Binding ErrorMessage}" Classes="error-text"
                                   Margin="0,0,0,14"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Register button -->
                        <Button Content="Register" Command="{Binding RegisterCommand}"
                                Classes="btn-primary" Height="46" HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                        <Button Content="Back" Command="{Binding GoBackCommand}"
                                Classes="btn-ghost" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
