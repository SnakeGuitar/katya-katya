<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.SinglePlayer"
             xmlns:lobby="using:KatyaKatya.Models.Lobby"
             x:Class="KatyaKatya.Views.SinglePlayer.SinglePlayerGameView"
             x:DataType="vm:SinglePlayerGameViewModel">

    <Grid Classes="page-bg" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- Game Layout Grid with entrance animation -->
        <Grid Classes="board-entrance" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════ LEFT: Stats Panel ══════════════ -->
            <Border Grid.Column="0"
                    Classes="glass-card"
                    Padding="18,16"
                    VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto, *, Auto">

                    <!-- Player Name & Separator -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PlayerName}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Rectangle Height="1" Fill="{DynamicResource PastelBorder}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Stats Stack -->
                    <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Top">

                        <!-- Pairs Found -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                            <Image Source="avares://KatyaKatya/Resources/Images/Icons/love-points.png"
                                   Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Pairs" Classes="stat-label" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Score}" Classes="stat-value score-pulse"/>

                        <!-- Attempts -->
                        <TextBlock Text="Attempts" Classes="stat-label"/>
                        <TextBlock Text="{Binding Attempts}" Classes="stat-value"/>

                        <!-- Turn Timer -->
                        <TextBlock Text="Turn Timer" Classes="stat-label"/>
                        <TextBlock Text="{Binding TurnTimerDisplay}" Classes="stat-value"/>

                        <!-- Elapsed -->
                        <TextBlock Text="Total Time" Classes="stat-label"/>
                        <TextBlock Text="{Binding ElapsedDisplay}" Classes="stat-value"/>
                    </StackPanel>

                    <!-- Leave button -->
                    <Button Grid.Row="2"
                            Command="{Binding LeaveGameCommand}"
                            Content="Leave Game"
                            Classes="btn-ghost"
                            HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- ══════════════ CENTER: Game Board ══════════════ -->
            <Border Grid.Column="2"
                    Classes="glass-card"
                    Padding="16"
                    VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding BoardRows}" Columns="{Binding BoardColumns}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="lobby:CardViewModel">
                                <Button Width="90" Height="90" Margin="4"
                                        Classes="animated-card"
                                        Command="{Binding $parent[UserControl].((vm:SinglePlayerGameViewModel)DataContext).FlipCardCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].((vm:SinglePlayerGameViewModel)DataContext).IsInteractionEnabled}">
                                    <Border Classes="card-face">
                                        <Grid>
                                            <Image Source="{Binding DisplayImage}" Stretch="Uniform" Margin="6"/>

                                            <!-- Match overlay (made visible via binding) -->
                                            <Border Classes="match-overlay"
                                                    IsVisible="{Binding IsMatched}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>
        </Grid>

        <!-- ══════════════ GAME OVER OVERLAY ══════════════ -->
        <Border Classes="game-over-backdrop"
                Background="#BF000000"
                IsVisible="{Binding ShowGameOver}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <Border Classes="game-over-card glass-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="450"
                    Padding="40,32">
                <StackPanel HorizontalAlignment="Center" Spacing="16">

                    <!-- Trophy emoji with wiggle animation -->
                    <TextBlock Text="🏆" FontSize="52" Classes="trophy-wiggle"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding GameOverTitle}"
                               Classes="h2"
                               FontFamily="{DynamicResource DisplayFont}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <TextBlock Text="{Binding GameOverStats}"
                               FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <Button Command="{Binding PlayAgainCommand}"
                                Content="Play Again"
                                Classes="btn-primary"
                                FontWeight="Bold"
                                Padding="28,10"/>
                        <Button Command="{Binding CloseGameOverCommand}"
                                Content="Leave"
                                Classes="btn-ghost"
                                Padding="20,10"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
