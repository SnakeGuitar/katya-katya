<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KatyaKatya</RootNamespace>
    <AssemblyName>KatyaKatya</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0-alpha.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml" />
    <AvaloniaResource Include="Resources\**" Exclude="Resources\**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Lang.es-MX.resx">
      <Culture>es-MX</Culture>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\Lang.ja-JP.resx">
      <Culture>ja-JP</Culture>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\Lang.zh-CN.resx">
      <Culture>zh-CN</Culture>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\Lang.ko-KR.resx">
      <Culture>ko-KR</Culture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copy music + sound-effect files to output directory so LibVLC can access them by path -->
  <ItemGroup>
    <Content Include="Resources\Music\**\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Sounds\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- MVVM & DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />

    <!-- Networking -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />

    <!-- Graphics: SkiaSharp for particle system (TBD - needs custom Avalonia integration) -->
    <PackageReference Include="SkiaSharp" />

    <!-- Audio -->
    <PackageReference Include="LibVLCSharp" />
  </ItemGroup>
</Project>
