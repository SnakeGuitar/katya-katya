<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Social"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.Social.FriendsView"
             x:DataType="vm:FriendsViewModel">

    <Grid>
        <!-- No background image: MainWindow's global background + animated clouds show through. -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button Grid.Row="1"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    Command="{Binding GoBackCommand}"
                    Width="48" Height="48"
                    Background="{DynamicResource PastelPrimary}"
                    BorderThickness="0" CornerRadius="24"
                    Cursor="Hand">
                <Image Source="avares://KatyaKatya/Resources/Images/Icons/return-icon.png"
                       Stretch="Uniform" Margin="14"/>
            </Button>

            <TextBlock Grid.Row="1"
                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Title]}"
                       Classes="PastelHeading"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Grid Grid.Row="2" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Friends list -->
                <Border Grid.Column="0" Classes="LiquidGlassCard" Padding="24,20">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_MyFriends]}"
                                   Classes="PastelLabel" FontSize="14"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_NoFriends]}"
                                   Classes="PastelTextBlock"
                                   Foreground="{DynamicResource PastelTextLight}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,24"
                                   IsVisible="{Binding !HasFriends}"/>
                        <ScrollViewer MaxHeight="400" IsVisible="{Binding HasFriends}">
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,12" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}"
                                                               Classes="PastelTextBlock"/>
                                                    <TextBlock Text="{Binding FriendsSince, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                               Classes="PastelLabel"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="PastelButtonDanger"
                                                        Content="x"
                                                        Command="{Binding $parent[UserControl].DataContext.RemoveFriendCommand}"
                                                        CommandParameter="{Binding}"
                                                        Height="28" Padding="10,0"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Friend requests -->
                <Border Grid.Column="2" Classes="LiquidGlassCard" Padding="24,20">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_AddFriend]}"
                                   Classes="PastelLabel" FontSize="14"
                                   Margin="0,0,0,12"/>
                        <TextBox Text="{Binding SearchUsername}"
                                 Classes="PastelTextBox"
                                 PlaceholderText="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_EnterUsername]}"
                                 Margin="0,0,0,10"/>
                        <Button Classes="PastelButton" Height="38"
                                Command="{Binding SendRequestCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Button_SendRequest]}"/>

                        <Rectangle Classes="SectionDivider"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_PendingRequests]}"
                                   Classes="PastelLabel" FontSize="14"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Label_NoRequests]}"
                                   Classes="PastelTextBlock"
                                   Foreground="{DynamicResource PastelTextLight}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,16"
                                   IsVisible="{Binding !HasRequests}"/>
                        <ScrollViewer MaxHeight="300" IsVisible="{Binding HasRequests}">
                            <ItemsControl ItemsSource="{Binding PendingRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SenderUsername}"
                                                           Classes="PastelTextBlock"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Classes="PastelButton"
                                                        Content="+"
                                                        Command="{Binding $parent[UserControl].DataContext.AcceptRequestCommand}"
                                                        CommandParameter="{Binding RequestId}"
                                                        Height="28" Width="32" Padding="0"
                                                        Margin="6,0,4,0"/>
                                                <Button Grid.Column="2"
                                                        Classes="PastelButtonSecondary"
                                                        Content="x"
                                                        Command="{Binding $parent[UserControl].DataContext.RejectRequestCommand}"
                                                        CommandParameter="{Binding RequestId}"
                                                        Height="28" Width="32" Padding="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
