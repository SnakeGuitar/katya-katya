<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Profile"
             xmlns:conv="using:KatyaKatya.Converters"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.Profile.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <UserControl.Resources>
        <conv:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmap"/>
    </UserControl.Resources>

    <Grid>
        <!-- No background image: MainWindow's global background + animated clouds show through. -->

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
              MaxWidth="900" Width="661">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile card -->
            <Border Grid.Row="0"
                    Classes="LiquidGlassCard"
                    Padding="50,48"
                    Margin="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: avatar + actions -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,50,0" Spacing="0">
                        <Border Width="140" Height="140"
                                CornerRadius="70"
                                BorderBrush="{DynamicResource PastelPrimary}"
                                BorderThickness="3"
                                HorizontalAlignment="Center"
                                Background="#10C84747"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="👤" FontSize="48"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding AvatarBytes, Converter={x:Static ObjectConverters.IsNull}}"/>
                                <Image Source="{Binding AvatarBytes, Converter={StaticResource ByteArrayToBitmap}}"
                                       Stretch="UniformToFill"
                                       Width="134" Height="134"
                                       IsVisible="{Binding AvatarBytes, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Grid>
                        </Border>

                        <Button Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                Classes="PastelButtonSecondary"
                                Height="36" Padding="20,0"
                                Command="{Binding GoToEditProfileCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[EditProfile_Label_EditProfile]}"/>

                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Classes="LinkButton"
                                Command="{Binding LogoutCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Logout]}"/>
                    </StackPanel>

                    <!-- Right: user info -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Username -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="{Binding Username}"
                                   Classes="PastelHeading"
                                   FontSize="36"
                                   Margin="0,0,0,24"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Full name -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Profile_Label_Name]}"
                                   Classes="PastelLabel" FontSize="14" Margin="0,0,16,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullName}"
                                   Classes="PastelTextBlock" FontSize="16"
                                   Foreground="{DynamicResource PastelPrimary}" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Session_Field_Email]}"
                                   Classes="PastelLabel" FontSize="14" Margin="0,0,16,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Email}"
                                   Classes="PastelTextBlock" FontSize="16"
                                   Foreground="{DynamicResource PastelPrimary}" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- Registered -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Profile_Label_RegistrationDate]}"
                                   Classes="PastelLabel" FontSize="14" Margin="0,0,16,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RegistrationDate}"
                                   Classes="PastelTextBlock" FontSize="16"
                                   Foreground="{DynamicResource PastelPrimary}" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- Social networks -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                                    Margin="0,12,0,0"
                                    IsVisible="{Binding HasSocialNetworks}">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Profile_Label_SocialNetworks]}"
                                       Classes="PastelLabel" FontSize="14" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SocialNetworks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="12,4,0,4" Spacing="8">
                                            <TextBlock Text="•"
                                                       Classes="PastelTextBlock"
                                                       Foreground="{DynamicResource PastelPrimary}"/>
                                            <TextBlock Text="{Binding Account}"
                                                       Classes="PastelTextBlock"
                                                       Foreground="{DynamicResource PastelPrimary}"
                                                       FontSize="15"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom nav -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20"
                        Spacing="16">
                <Button Classes="PastelButton" Height="46" Padding="32,0"
                        Command="{Binding GoToFriendsCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Title]}"/>
                <Button Classes="LinkButton"
                        Command="{Binding GoBackCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
