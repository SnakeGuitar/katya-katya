<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.MainMenu"
             xmlns:controls="using:KatyaKatya.Controls"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.MainMenu.MainMenuView"
             x:DataType="vm:MainMenuViewModel">

    <Grid>
        <Image Source="{Binding BackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <!-- Falling cherry-blossom petals (behind the character) -->
        <controls:ParticleCanvas Name="PetalCanvas" IsHitTestVisible="False"/>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="500"
                    Margin="0,-18,0,0">

            <Image Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                   Height="280"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   Margin="0,0,0,20"
                   Classes="FloatingLogo"/>

            <Border Name="ButtonPanelBorder"
                    Margin="60,0,60,0"
                    Classes="LiquidGlassCard"
                    Padding="0"
                    ClipToBounds="True">

                <Grid>
                    <!-- Interactive cursor glow overlay (center follows the pointer from code-behind) -->
                    <Border Name="GlowOverlay"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <Border.Background>
                            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%">
                                <GradientStop Color="#D5FFFFFF" Offset="0"/>
                                <GradientStop Color="#65FFB6C1" Offset="0.4"/>
                                <GradientStop Color="#25FFD1DC" Offset="0.8"/>
                                <GradientStop Color="#00FFD1DC" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                <Border Padding="32,28,32,24">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding WelcomeMessage}"
                                   Classes="PastelTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <Button Height="48" Margin="0,0,0,12"
                                Classes="PastelButton"
                                HorizontalAlignment="Stretch"
                                Command="{Binding GoToSingleplayerCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_Singleplayer]}"/>

                        <Button Height="48" Margin="0,0,0,12"
                                Classes="PastelButton"
                                HorizontalAlignment="Stretch"
                                Command="{Binding GoToMultiplayerCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_Multiplayer]}"/>

                        <Button Height="48" Margin="0,0,0,20"
                                Classes="PastelButton"
                                HorizontalAlignment="Stretch"
                                Command="{Binding GoToMoreCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_More]}"/>

                        <Rectangle Classes="SectionDivider" Margin="20,0,20,4"/>

                        <Button HorizontalAlignment="Center"
                                Classes="LinkButton"
                                Command="{Binding LogoutCommand}"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Logout]}"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>
        </StackPanel>

        <controls:AlphaHitTestButton HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     MaxWidth="720"
                                     MaxHeight="900"
                                     Margin="0,0,28,-8"
                                     Cursor="Hand"
                                     RenderTransformOrigin="0.5,1"
                                     AlphaMaskSource="{Binding CurrentMoodImage}"
                                     Command="{Binding GoToDatingCommand}">
            <controls:AlphaHitTestButton.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </controls:AlphaHitTestButton.Transitions>
            <controls:AlphaHitTestButton.Styles>
                <Style Selector="controls|AlphaHitTestButton:pointerover">
                    <Setter Property="RenderTransform" Value="scale(1.04)"/>
                </Style>
            </controls:AlphaHitTestButton.Styles>
            <Image Source="{Binding CurrentMoodImage, Converter={StaticResource StringAssetToBitmapConverter}}"
                   Stretch="Uniform"
                   IsHitTestVisible="False"/>
        </controls:AlphaHitTestButton>
    </Grid>
</UserControl>
