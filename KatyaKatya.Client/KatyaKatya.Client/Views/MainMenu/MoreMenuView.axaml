<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.MainMenu"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.MainMenu.MoreMenuView"
             x:DataType="vm:MoreMenuViewModel">

    <Grid>
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=GlobalBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowDefinitions="Auto,32,Auto,28,Auto">
            <TextBlock Grid.Row="0"
                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_More]}"
                       Classes="PastelHeading"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20">

                <Button Command="{Binding GoToGalleryCommand}"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        Cursor="Hand"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Width="200" Height="180"
                        Padding="28,32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🃏" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Gallery_Title]}"
                                   Classes="PastelTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding GoToProfileCommand}"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        Cursor="Hand"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Width="200" Height="180"
                        Padding="28,32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Profile_Title]}"
                                   Classes="PastelTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding GoToFriendsCommand}"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        Cursor="Hand"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Width="200" Height="180"
                        Padding="28,32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🤝" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Friends_Title]}"
                                   Classes="PastelTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Row="4"
                    HorizontalAlignment="Center"
                    Classes="LinkButton"
                    Command="{Binding GoBackCommand}"
                    Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"/>
        </Grid>
    </Grid>
</UserControl>
