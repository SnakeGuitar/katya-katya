<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Android / mobile shell — no custom chrome, just the navigation surface -->
    <Grid Background="{DynamicResource PastelBackground}">
        <!-- Background image -->
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=GlobalBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <!-- Active view -->
        <ContentControl Content="{Binding DisplayedViewModel}"
                        Classes="ViewFade"/>
    </Grid>
</UserControl>
