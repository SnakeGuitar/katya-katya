<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.SinglePlayer"
             xmlns:models="using:KatyaKatya.Models.Lobby"
             xmlns:loc="using:KatyaKatya.Localization"
             xmlns:controls="using:KatyaKatya.Controls"
             x:Class="KatyaKatya.Views.SinglePlayer.SinglePlayerGameView"
             x:DataType="vm:SinglePlayerGameViewModel">

    <Grid>
        <Image Source="avares://KatyaKatya/Resources/Images/Backgrounds/background-minimalistic.png"
               Stretch="UniformToFill" IsHitTestVisible="False"/>

        <controls:ParticleCanvas Name="ParticleCanvas"
                                  ZIndex="250"
                                  IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <!-- HUD -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackground}"
                    Padding="20,0"
                    Margin="16,8,16,0"
                    CornerRadius="14"
                    BoxShadow="2 2 10 0 #1A3D1C1C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quit -->
                    <Button Grid.Column="0"
                            Classes="LinkButton"
                            Command="{Binding LeaveGameCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Leave]}"
                            VerticalAlignment="Center"/>

                    <!-- Score -->
                    <StackPanel Name="StatsPanel"
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0">
                        <TextBlock Text="{Binding Score}"
                                   Classes="PastelHeading ScorePulse"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PastelPrimary}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Label_Score]}"
                                   Classes="PastelLabel"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Turn timer -->
                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="0">
                        <TextBlock Text="{Binding TurnTimerDisplay}"
                                   Classes="PastelHeading"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PastelPrimary}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_TurnTime]}"
                                   Classes="PastelLabel"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card grid.
                 Parent binding uses ReflectionBinding because DataContext inside the template
                 is CardViewModel, not SinglePlayerGameViewModel. -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Cards}"
                          Margin="16,8,16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{ReflectionBinding BoardColumns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CardViewModel">
                        <Button Margin="4"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Cursor="Hand"
                                IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.IsInteractionEnabled}"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.FlipCardCommand}"
                                CommandParameter="{Binding}">
                            <Border CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <!-- Card back -->
                                    <Border Classes="CardBack"
                                            Background="{DynamicResource PrimaryGradient}"
                                            CornerRadius="12"
                                            IsVisible="{Binding !IsFlipped}">
                                        <TextBlock Text="🂠"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Border>
                                    <!-- Card front -->
                                    <Border Classes="CardFront"
                                            Background="{DynamicResource CardBackground}"
                                            CornerRadius="12"
                                            BorderBrush="{DynamicResource PastelBorder}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding IsFlipped}">
                                        <Image Source="{Binding DisplayImage}"
                                               Stretch="Uniform"
                                               Margin="8"/>
                                    </Border>
                                    <!-- Match overlay -->
                                    <Border CornerRadius="12"
                                            Background="{DynamicResource MatchOverlayBrush}"
                                            IsVisible="{Binding IsMatched}"
                                            Classes="MatchPulse"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Game-over overlay -->
        <Grid IsVisible="{Binding ShowGameOver}"
              ZIndex="300"
              Background="#99000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="LiquidGlassCard"
                    Width="400"
                    Padding="36,32">
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding GameOverTitle}"
                               Classes="PastelHeading"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding GameOverStats}"
                               Classes="PastelLabel"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    <Button Classes="PastelButton"
                            Height="44"
                            Margin="0,0,0,10"
                            Command="{Binding PlayAgainCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_PlayAgain]}"/>
                    <Button Classes="PastelButtonSecondary"
                            Height="44"
                            Command="{Binding CloseGameOverCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
