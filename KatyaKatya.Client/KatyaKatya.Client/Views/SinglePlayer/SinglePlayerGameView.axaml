<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.SinglePlayer"
             xmlns:models="using:KatyaKatya.Models.Lobby"
             xmlns:loc="using:KatyaKatya.Localization"
             xmlns:controls="using:KatyaKatya.Controls"
             x:Class="KatyaKatya.Views.SinglePlayer.SinglePlayerGameView"
             x:DataType="vm:SinglePlayerGameViewModel">

    <Grid>
        <!-- No background image: MainWindow's global background + animated clouds show through. -->

        <controls:ParticleCanvas Name="ParticleCanvas"
                                  ZIndex="250"
                                  IsHitTestVisible="False"/>

        <!-- Top margin clears the 48px window drag strip (MainWindow DragArea, ZIndex 50),
             which otherwise sits over this area and swallows clicks on the Quit button. -->
        <Grid Margin="0,44,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <!-- HUD -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackground}"
                    Padding="20,0"
                    Margin="16,8,16,0"
                    CornerRadius="14"
                    BoxShadow="2 2 10 0 #1A3D1C1C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quit -->
                    <Button Grid.Column="0"
                            Classes="LinkButton"
                            Command="{Binding LeaveGameCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Leave]}"
                            VerticalAlignment="Center"/>

                    <!-- Score / Attempts / Elapsed -->
                    <StackPanel Name="StatsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="32">
                        <StackPanel Spacing="0">
                            <TextBlock Name="ScoreText"
                                       Text="{Binding Score}"
                                       Classes="PastelHeading"
                                       Classes.ScorePulse="{Binding ScorePulseActive}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PastelPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Label_Score]}"
                                       Classes="PastelLabel"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Attempts}"
                                       Classes="PastelHeading"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PastelPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Attempts]}"
                                       Classes="PastelLabel"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding ElapsedDisplay}"
                                       Classes="PastelHeading"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PastelPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Elapsed]}"
                                       Classes="PastelLabel"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Total timer -->
                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="0">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   Classes="PastelHeading"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PastelPrimary}"/>
                        <TextBlock Text="{Binding TimeLabel}"
                                   Classes="PastelLabel"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card board — glass panel + Viewbox so cards scale up uniformly and stay
                 square (parity with the multiplayer GameBoardView).
                 Parent binding uses ReflectionBinding because DataContext inside the template
                 is CardViewModel, not SinglePlayerGameViewModel. -->
            <Border Grid.Row="1"
                    Classes="LiquidGlassCard"
                    Margin="16,8,16,0"
                    Padding="16">
                <Viewbox Stretch="Uniform">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{ReflectionBinding BoardRows}"
                                             Columns="{ReflectionBinding BoardColumns}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CardViewModel">
                                <Button Width="90"
                                        Height="90"
                                        Margin="4"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="12"
                                        Cursor="Hand"
                                        IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.IsInteractionEnabled}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.FlipCardCommand}"
                                        CommandParameter="{Binding}">
                                    <Border CornerRadius="12" ClipToBounds="True">
                                        <Grid Classes="CardFlip"
                                              Classes.flipped="{Binding IsFlipped}"
                                              Classes.matched="{Binding IsMatched}">
                                            <!-- Card back -->
                                            <Border Classes="CardBack"
                                                    CornerRadius="12"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource PrimaryGradient}"
                                                    IsVisible="{Binding !IsFlipped}">
                                                <Image Source="avares://KatyaKatya/Resources/Images/Cards/card-reverse.png"
                                                       Stretch="Uniform"/>
                                            </Border>
                                            <!-- Card front -->
                                            <Border Classes="CardFront"
                                                    Background="{DynamicResource CardBackground}"
                                                    CornerRadius="12"
                                                    BorderBrush="{DynamicResource PastelBorder}"
                                                    BorderThickness="1.5"
                                                    IsVisible="{Binding IsFlipped}">
                                                <Image Source="{Binding DisplayImage}"
                                                       Stretch="Uniform"
                                                       Margin="8"/>
                                            </Border>
                                            <!-- Match overlay -->
                                            <Border CornerRadius="12"
                                                    Background="{DynamicResource MatchOverlayBrush}"
                                                    IsVisible="{Binding IsMatched}"
                                                    Classes="MatchPulse"/>
                                            <Ellipse Classes="MatchRing"
                                                     Classes.matched="{Binding IsMatched}"
                                                     Stroke="{DynamicResource MatchRingBrush}"
                                                     StrokeThickness="3"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Game-over overlay -->
        <Border IsVisible="{Binding ShowGameOver}"
                ZIndex="300"
                Background="#99000000"
                Classes="GameOverVeil"
                Classes.open="{Binding ShowGameOver}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="LiquidGlassCard GameOverEntrance"
                    Classes.open="{Binding ShowGameOver}"
                    Width="400"
                    Padding="36,32">
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                    <TextBlock Text="🏆"
                               Classes="TrophyWiggle"
                               Classes.open="{Binding ShowGameOver}"
                               FontSize="52"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding GameOverTitle}"
                               Classes="PastelHeading"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding GameOverStats}"
                               Classes="PastelLabel"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    <Button Classes="PastelButton"
                            Height="44"
                            Margin="0,0,0,10"
                            Command="{Binding PlayAgainCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_PlayAgain]}"/>
                    <Button Classes="PastelButtonSecondary"
                            Height="44"
                            Command="{Binding CloseGameOverCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
