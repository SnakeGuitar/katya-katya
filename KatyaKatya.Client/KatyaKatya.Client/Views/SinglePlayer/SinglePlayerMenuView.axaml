<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.SinglePlayer"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.SinglePlayer.SinglePlayerMenuView"
             x:DataType="vm:SinglePlayerMenuViewModel">

    <Grid>
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=GlobalBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill" IsHitTestVisible="False"/>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="680" RowDefinitions="Auto,16,Auto,24,Auto">
            <TextBlock Grid.Row="0"
                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_Singleplayer]}"
                       Classes="PastelHeading"
                       HorizontalAlignment="Center"/>

            <Border Grid.Row="2"
                    Classes="LiquidGlassCard"
                    Padding="32,28">
                <Grid ColumnDefinitions="*,28,*">
                    <StackPanel Grid.Column="0" Spacing="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_SelectDifficulty]}"
                                   Classes="PastelTextBlock"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   Margin="0,0,0,14"/>

                        <Button Command="{Binding SelectEasyCommand}"
                                Classes="DifficultyButton"
                                Classes.selected="{Binding IsEasy}"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="E" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Easy]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Easy_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectMediumCommand}"
                                Classes="DifficultyButton"
                                Classes.selected="{Binding IsMedium}"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="M" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Medium]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Medium_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectHardCommand}"
                                Classes="DifficultyButton"
                                Classes.selected="{Binding IsHard}"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="H" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Hard]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Hard_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectCustomCommand}"
                                Classes="DifficultyButton"
                                Classes.selected="{Binding IsCustomMode}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="C" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Button_Custom]}"
                                               FontSize="15" FontFamily="{DynamicResource DefaultFont}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_Custom_Desc]}"
                                               FontSize="11" Opacity="0.7" FontFamily="{DynamicResource DefaultFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                IsVisible="{Binding IsCustomMode}"
                                Spacing="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_CustomSettings]}"
                                   Classes="PastelTextBlock"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource PastelPrimary}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Classes="PastelTextBlock" FontSize="13" Margin="0,0,0,6">
                            <Run Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_CardCount]}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding CustomCardCount}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding CustomCardCountOptions}"
                                  SelectedItem="{Binding CustomCardCount}"
                                  Classes="PastelComboBox"
                                  Margin="0,0,0,18"/>

                        <CheckBox IsChecked="{Binding CustomNoTimeLimit}"
                                  Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_NoTimeLimit]}"
                                  Foreground="{DynamicResource PastelText}"
                                  FontFamily="{DynamicResource DefaultFont}"
                                  Margin="0,0,0,12"/>

                        <StackPanel IsVisible="{Binding ShowCustomTurnTime}" Spacing="0">
                            <TextBlock Classes="PastelTextBlock" FontSize="13" Margin="0,0,0,6">
                                <Run Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_TurnTime]}"/>
                                <Run Text=": "/>
                                <Run Text="{Binding CustomTurnTime}" FontWeight="SemiBold"/>
                                <Run Text="s"/>
                            </TextBlock>
                            <Slider Minimum="5"
                                    Maximum="120"
                                    Value="{Binding CustomTurnTime}"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Classes="PastelSlider"
                                    Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding !IsCustomMode}"
                                Spacing="16">
                        <TextBlock Text="Cards" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SinglePlayer_Label_SelectDifficulty]}"
                                   Classes="PastelTextBlock"
                                   FontSize="14"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="24">
                <Button Classes="LinkButton"
                        Command="{Binding GoBackCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"/>
                <Button Classes="PastelButton"
                        Command="{Binding StartGameCommand}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Play]}"
                        Height="44"
                        Padding="32,0"
                        FontSize="15"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
