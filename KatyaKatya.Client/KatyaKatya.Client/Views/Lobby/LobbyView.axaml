<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Lobby"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.Lobby.LobbyView"
             x:DataType="vm:LobbyViewModel">

    <Grid>
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=GlobalBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill" IsHitTestVisible="False"/>

        <Grid RowDefinitions="40,80,*,16">
            <Button Grid.Row="1"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    Command="{Binding LeaveCommand}"
                    Width="48" Height="48"
                    Background="{DynamicResource PastelPrimary}"
                    BorderThickness="0" CornerRadius="24" Cursor="Hand">
                <Image Source="avares://KatyaKatya/Resources/Images/Icons/return-icon.png"
                       Stretch="Uniform" Margin="14"/>
            </Button>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MainMenu_Button_Multiplayer]}"
                           Classes="PastelLabel"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Label_GameCode]}"
                           Classes="PastelLabel"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GameCode}"
                           Classes="PastelHeading"
                           FontSize="22"
                           Foreground="{DynamicResource PastelPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="24" ColumnDefinitions="*,24,300">
                <Border Grid.Column="0" Classes="LiquidGlassCard" Padding="24,20">
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Label_Players]}"
                                   Classes="PastelLabel"
                                   FontSize="14"
                                   Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,12" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="👤"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Username}"
                                                       Classes="PastelTextBlock"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="👑"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsHost}"/>
                                            <Button Grid.Column="3"
                                                    Classes="MiniDangerButton"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsHost}"
                                                    Command="{Binding $parent[UserControl].DataContext.VoteToKickCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="⚑"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Lobby_Label_WaitingPlayers]}"
                                   Classes="PastelLabel"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="LiquidGlassCard" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Lobby_Label_Chat]}"
                                   Classes="PastelLabel"
                                   FontSize="14"
                                   Margin="0,0,0,12"/>

                        <ScrollViewer Name="ChatScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Classes="PastelTextBlock"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ChatMessage}"
                                     Classes="PastelTextBox"
                                     PlaceholderText="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Lobby_Label_TypeMessage]}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SendChatMessageCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Classes="PastelButton"
                                    Height="40"
                                    Padding="14,0"
                                    Margin="6,0,0,0"
                                    Command="{Binding SendChatMessageCommand}"
                                    Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Send]}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
