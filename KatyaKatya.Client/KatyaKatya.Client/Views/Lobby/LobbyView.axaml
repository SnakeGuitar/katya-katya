<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Lobby"
             x:Class="KatyaKatya.Views.Lobby.LobbyView"
             x:DataType="vm:LobbyViewModel">

    <Grid>
        <Image Source="avares://KatyaKatya/Resources/Images/Backgrounds/background-minimalistic.png"
               Stretch="UniformToFill" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="1"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    Command="{Binding LeaveCommand}"
                    Width="48" Height="48"
                    Background="{DynamicResource PastelPrimary}"
                    BorderThickness="0" CornerRadius="24" Cursor="Hand">
                <Image Source="avares://KatyaKatya/Resources/Images/Icons/return-icon.png"
                       Stretch="Uniform" Margin="14"/>
            </Button>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="Lobby  ·  Code:"
                           Classes="PastelLabel" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GameCode}"
                           Classes="PastelHeading"
                           FontSize="22"
                           Foreground="{DynamicResource PastelPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Players list -->
                <Border Grid.Column="0" Classes="LiquidGlassCard" Padding="24,20">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Players" Classes="PastelLabel" FontSize="14" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="👤" FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Username}"
                                                       Classes="PastelTextBlock"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="HOST"
                                                       Classes="PastelLabel"
                                                       Foreground="{DynamicResource PastelPrimary}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsHost}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Waiting for host to start -->
                        <TextBlock Text="Waiting for host to start the game…"
                                   Classes="PastelLabel"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Chat -->
                <Border Grid.Column="2" Classes="LiquidGlassCard" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Classes="PastelTextBlock"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ChatMessage}"
                                     Classes="PastelTextBox"
                                     PlaceholderText="Message…"/>
                            <Button Grid.Column="1"
                                    Classes="PastelButton"
                                    Height="40" Padding="14,0"
                                    Margin="6,0,0,0"
                                    Command="{Binding SendChatMessageCommand}"
                                    Content="→"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
