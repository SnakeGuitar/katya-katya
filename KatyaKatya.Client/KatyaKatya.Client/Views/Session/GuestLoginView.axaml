<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.Session.GuestLoginView"
             x:DataType="vm:GuestLoginViewModel">

    <Grid>
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=GlobalBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                   Width="280" Height="280"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40,0,0,0"
                   Stretch="Uniform"/>

            <Border Grid.Column="1"
                    Classes="LiquidGlassCard"
                    Width="360"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="36,32"
                    Margin="0,0,40,0">

                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Session_Guest_Title]}"
                               Classes="PastelHeading"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Session_Guest_Description]}"
                               Classes="PastelTextBlock"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Session_Field_Username]}"
                               Classes="PastelLabel"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="PastelTextBox"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Classes="PastelErrorText"
                               Margin="0,0,0,14"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Button Height="46"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"
                            Classes="PastelButton"
                            Command="{Binding LoginAsGuestCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Play]}"/>

                    <Button HorizontalAlignment="Center"
                            Classes="LinkButton"
                            Command="{Binding GoBackCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Global_Button_Back]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
