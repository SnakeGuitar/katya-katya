<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KatyaKatya.ViewModels.Session"
             xmlns:conv="using:KatyaKatya.Converters"
             xmlns:loc="using:KatyaKatya.Localization"
             x:Class="KatyaKatya.Views.Session.SplashScreenView"
             x:DataType="vm:SplashScreenViewModel">

    <!-- No solid background: the window's GlobalBgImage shows through as this fades out -->
    <Grid>
        <!-- Blurred background image for diffusion effect -->
        <Image Source="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=MainMenuBackgroundPath, Converter={StaticResource StringAssetToBitmapConverter}}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               Opacity="0.65"
               Effect="blur(18)"/>

        <!-- Logo — code-behind animates opacity on load -->
        <Border Name="LogoContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360" Height="360"
                Opacity="0">
            <Image Source="{Binding LogoPath, Converter={StaticResource StringAssetToBitmapConverter}}"
                   Stretch="Uniform"/>
        </Border>
    </Grid>
</UserControl>
