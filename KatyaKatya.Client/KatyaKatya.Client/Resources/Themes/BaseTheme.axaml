<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         Warm Rose / Crimson Palette
         ========================================================= -->
    <SolidColorBrush x:Key="PastelBackground"      Color="#FDF8F8"/>
    <SolidColorBrush x:Key="PastelPrimary"          Color="#C84747"/>
    <SolidColorBrush x:Key="PastelPrimaryHover"     Color="#B03A3A"/>
    <SolidColorBrush x:Key="PastelText"             Color="#3D1C1C"/>
    <SolidColorBrush x:Key="PastelTextLight"        Color="#613D3D"/>
    <SolidColorBrush x:Key="PastelError"            Color="#B82A2A"/>
    <SolidColorBrush x:Key="PastelSuccess"          Color="#B8F0D0"/>
    <SolidColorBrush x:Key="LinkText"               Color="#AF1010"/>
    <SolidColorBrush x:Key="LinkTextHover"          Color="#8A0D0D"/>
    <SolidColorBrush x:Key="MatchRingBrush"         Color="#00C853"/>
    <SolidColorBrush x:Key="MatchOverlayBrush"      Color="#3000C853"/>

    <!-- Secondary glass brush -->
    <LinearGradientBrush x:Key="PastelSecondary" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#CCF8E6E6" Offset="0"/>
        <GradientStop Color="#80E8C4C4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PastelAccent" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFE8D8D8" Offset="0"/>
        <GradientStop Color="#BBE0C0C0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass border diagonal -->
    <LinearGradientBrush x:Key="PastelBorder" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#D0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.5"/>
        <GradientStop Color="#40C84747" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Liquid Glass card background — a crisp specular sheen at the top rolls into a
         faint translucent base so the animated clouds glow through the material. The
         slightly diagonal sweep gives the surface a more "wet glass" light direction. -->
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0%,0%" EndPoint="14%,100%">
        <GradientStop Color="#A0FFFFFF" Offset="0"/>
        <GradientStop Color="#6CFFFBFB" Offset="0.18"/>
        <GradientStop Color="#42FFF2F2" Offset="0.55"/>
        <GradientStop Color="#1CEFD6D6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Diagonal specular streak overlaid on glass surfaces for a liquid highlight. -->
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#58FFFFFF" Offset="0.15"/>
        <GradientStop Color="#12FFFFFF" Offset="0.33"/>
        <GradientStop Color="#00FFFFFF" Offset="0.62"/>
    </LinearGradientBrush>

    <!-- Primary gradient — warm rose -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#E6E07070" Offset="0"/>
        <GradientStop Color="#B3C04848" Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary button gradient — glossy liquid-glass tint: luminous top, deep base.
         Slightly translucent so the background glows faintly through the glass. -->
    <LinearGradientBrush x:Key="PastelButtonBg" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#F5FF9D9D" Offset="0"/>
        <GradientStop Color="#EEE96868" Offset="0.14"/>
        <GradientStop Color="#E6CB3B3B" Offset="0.5"/>
        <GradientStop Color="#E69E2020" Offset="1"/>
    </LinearGradientBrush>

    <!-- =========================================================
         Typography  —  Fredoka (display) + Nunito (UI)
         ========================================================= -->
    <FontFamily x:Key="DefaultFont">avares://KatyaKatya/Resources/Fonts#Nunito</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://KatyaKatya/Resources/Fonts#Fredoka</FontFamily>

    <!-- =========================================================
         Corner Radii
         ========================================================= -->
    <CornerRadius x:Key="ButtonCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">22</CornerRadius>

    <!-- =========================================================
         Shadows — Liquid Glass: soft outer depth + inset specular rim + inner glow
         (inset goes first in Avalonia's BoxShadow syntax)
         ========================================================= -->
    <BoxShadows x:Key="CardBoxShadow">0 16 40 -8 #40000000, 0 0 32 2 #42E86A6A, inset 0 1.5 1 0 #DCFFFFFF, inset 0 0 0 1 #4CFFFFFF, inset 0 -20 28 -12 #22FFFFFF</BoxShadows>
    <BoxShadows x:Key="ButtonShadow">0 8 18 -3 #59C83737, inset 0 1.5 1 0 #9EFFFFFF, inset 0 0 0 1 #38FFFFFF, inset 0 -9 13 -7 #33000000</BoxShadows>
    <BoxShadows x:Key="ButtonShadowHover">0 13 34 -3 #94E84545, inset 0 2 2 0 #BAFFFFFF, inset 0 0 0 1 #4FFFFFFF, inset 0 -9 13 -7 #33000000</BoxShadows>
    <BoxShadows x:Key="SecondaryButtonShadow">0 4 14 -2 #25C84747, inset 0 1 1 0 #99FFFFFF</BoxShadows>

</ResourceDictionary>
